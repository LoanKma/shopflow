meta {
  name: Liste des produits
  type: http
  seq: 1
}

get {
  url: {{catalog}}/api/v1/products
  body: none
  auth: none
}

tests {
  test("200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("10 produits", function () {
    expect(res.getBody().content).to.have.lengthOf(10);
    expect(res.getBody().page.totalElements).to.equal(10);
  });
}
