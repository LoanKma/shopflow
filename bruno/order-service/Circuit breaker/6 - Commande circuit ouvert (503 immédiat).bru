        "quantity": 1
      }
    ]
  }
}

tests {
  test("503 immédiat, message « circuit ouvert »", function () {
    expect(res.getStatus()).to.equal(503);
    expect(res.getBody().detail).to.include("circuit est ouvert");
  });
}
