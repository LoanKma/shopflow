meta {
  name: 1 - Config Server order-service
  type: http
  seq: 1
}

get {
  url: http://localhost:8888/order-service/default
  body: none
  auth: none
}

tests {
  test("200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("deux sources : order-service.yml et application.yml", function () {
    const sources = res.getBody().propertySources.map(s => s.name);
    expect(sources).to.have.lengthOf(2);
    expect(sources[0]).to.contain("order-service.yml");
    expect(sources[1]).to.contain("application.yml");
  });
}
