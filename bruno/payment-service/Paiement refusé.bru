meta {
  name: Paiement refusé
  type: http
  seq: 1
}

post {
  url: {{payment}}/api/v1/payments
  body: json
  auth: none
}

body:json {
  {
    "orderId": {{paymentOrderId}},
    "customerId": "c-1",
    "amount": 1199.00
  }
}

script:pre-request {
  // Un orderId différent à chaque lancement : sinon le 2e lancement répond 409 (commande déjà payée)
  bru.setVar("paymentOrderId", Date.now());
}

tests {
  test("201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("statut REFUSED", function () {
    expect(res.getBody().status).to.equal("REFUSED");
  });
}
