meta {
  name: 6 - Commande circuit ouvert (503 immédiat)
  type: http
  seq: 6
}

post {
  url: {{order}}/api/v1/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "customerId": "c-1",
    "lines": [
      {
