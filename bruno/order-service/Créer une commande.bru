meta {
  name: Créer une commande
  type: http
  seq: 1
}

post {
  url: {{order}}/api/v1/orders
  body: json
  auth: none
}

body:json {
  {
    "customerId": "c-1",
    "lines": [
      { "productId": 1, "quantity": 2 },
      { "productId": 2, "quantity": 1 }
    ]
  }
}

script:post-response {
  bru.setVar("orderId", res.getBody().id);
}

tests {
  test("201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("total 229.70, statut PENDING", function () {
    expect(res.getBody().total).to.equal(229.70);
    expect(res.getBody().status).to.equal("PENDING");
  });
}
